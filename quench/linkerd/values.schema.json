{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks linkerd values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "controllerImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "policyController": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "tag",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "logLevel": {
          "type": "string",
          "minLength": 1
        },
        "defaultInboundPolicy": {
          "type": "string",
          "enum": [
            "all-unauthenticated",
            "all-authenticated",
            "cluster-authenticated",
            "cluster-unauthenticated",
            "deny",
            "audit"
          ]
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustDomain": {
          "type": "string",
          "minLength": 1
        },
        "trustAnchorsPEM": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "issuanceLifetime": {
          "type": "string"
        },
        "clockSkewAllowance": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object"
        }
      }
    },
    "proxyInjector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object"
        },
        "failurePolicy": {
          "type": "string",
          "enum": [
            "Ignore",
            "Fail"
          ]
        }
      }
    },
    "clusterNetworks": {
      "type": "string",
      "minLength": 1
    },
    "defaultOpaquePorts": {
      "type": "string"
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "controllerLogLevel": {
      "type": "string",
      "enum": [
        "panic",
        "fatal",
        "error",
        "warn",
        "info",
        "debug",
        "trace"
      ]
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "global": {
      "type": "object"
    },
    "quench-common": {
      "type": "object"
    },
    "kubeAPIServerPorts": {
      "type": "string",
      "pattern": "^[0-9,]+$"
    }
  }
}
