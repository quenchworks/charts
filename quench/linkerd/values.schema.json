{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks linkerd values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "controllerImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "controllerLogLevel": {
      "type": "string",
      "enum": [
        "panic",
        "fatal",
        "error",
        "warn",
        "info",
        "debug",
        "trace"
      ]
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "trustDomain": {
          "type": "string"
        },
        "trustAnchorsPEM": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "issuanceLifetime": {
          "type": "string"
        },
        "clockSkewAllowance": {
          "type": "string"
        }
      }
    },
    "policyController": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "clusterNetworks": {
          "type": "string"
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "prometheusUrl": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ]
        },
        "destinationPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "destinationAdminPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "identityPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "identityAdminPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "policyPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "policyAdminPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automountServiceAccountToken": {
          "type": "boolean",
          "description": "Mount the ServiceAccount token. Must stay true: linkerd-destination watches Services/EndpointSlices and needs API access."
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowExternal": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "customStartupProbe": {
      "type": "object"
    },
    "customLivenessProbe": {
      "type": "object"
    },
    "customReadinessProbe": {
      "type": "object"
    },
    "updateStrategy": {
      "type": "object"
    },
    "extraEnvVars": {
      "type": "array"
    },
    "extraEnvVarsCM": {
      "type": "string"
    },
    "extraEnvVarsSecret": {
      "type": "string"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "initContainers": {
      "type": "array"
    },
    "sidecars": {
      "type": "array"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    }
  }
}
