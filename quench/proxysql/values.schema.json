{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks proxysql values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "adminPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowExternal": {
          "type": "boolean"
        },
        "extraLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ingressPorts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "denyAllEgress": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "extraLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "type": "string",
          "enum": [
            "IfHealthyBudget",
            "AlwaysAllow"
          ]
        },
        "extraSelectorLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "fullnameOverride": {
      "type": "string"
    },
    "partOf": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "selectorLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        }
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        }
      }
    },
    "mysqlServers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hostname"
        ],
        "additionalProperties": false,
        "properties": {
          "hostname": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "hostgroup": {
            "type": "integer",
            "minimum": 0
          },
          "weight": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "mysqlUsers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string"
          },
          "defaultHostgroup": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "replicationHostgroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "writerHostgroup",
          "readerHostgroup"
        ],
        "additionalProperties": false,
        "properties": {
          "writerHostgroup": {
            "type": "integer",
            "minimum": 0
          },
          "readerHostgroup": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "extraConfig": {
      "type": "string"
    },
    "threads": {
      "type": "integer",
      "minimum": 1
    },
    "maxConnections": {
      "type": "integer",
      "minimum": 1
    }
  }
}
