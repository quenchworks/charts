{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks tika values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "javaOpts": {
      "type": "string"
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Issuer",
                    "ClusterIssuer"
                  ]
                }
              }
            },
            "dnsNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "duration": {
              "type": "string"
            }
          }
        },
        "selfSigned": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "validityDays": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "openssl": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string"
        }
      }
    }
  }
}
