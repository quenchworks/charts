{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks automation-stack values",
  "type": "object",
  "properties": {
    "n8n": { "type": "object" },
    "postgresql": { "type": "object" },
    "valkey": { "type": "object" },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "image": { "type": "object", "properties": { "repository": { "type": "string" }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }, "required": ["repository", "digest"] }
      }
    }
  }
}
