{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks vcluster values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "vcluster": {
      "type": "object",
      "description": "vcluster.yaml for 0.37; parsed strictly by the syncer",
      "required": [
        "controlPlane",
        "sync"
      ]
    }
  }
}
