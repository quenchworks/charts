{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks cdi-operator values",
  "type": "object",
  "required": ["images"],
  "properties": {
    "images": {
      "type": "object",
      "required": ["cdi-operator", "cdi-controller", "cdi-apiserver", "cdi-uploadproxy", "cdi-uploadserver", "cdi-importer", "cdi-cloner"],
      "additionalProperties": {
        "type": "object",
        "required": ["repository", "digest"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
    "verbosity": { "type": "integer", "minimum": 0 },
    "resources": { "type": "object" },
    "cdi": {
      "type": "object",
      "properties": { "create": { "type": "boolean" }, "spec": { "type": "object" } }
    }
  }
}
