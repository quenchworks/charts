{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks dapr values",
  "type": "object",
  "additionalProperties": true,
  "required": ["quenchworksImage", "dapr"],
  "properties": {
    "quenchworksImage": {
      "type": "string",
      "pattern": "^ghcr\\.io/quenchworks/images/dapr@sha256:[0-9a-f]{64}$"
    },
    "dapr": { "type": "object" }
  }
}
