{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks kured values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "rebootCommand": {
      "type": "string",
      "minLength": 1
    },
    "sentinelHostPath": {
      "type": "string",
      "minLength": 1
    },
    "sentinelFile": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "minLength": 1
    },
    "rebootDays": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "su",
          "mo",
          "tu",
          "we",
          "th",
          "fr",
          "sa",
          "sunday",
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday"
        ]
      }
    },
    "startTime": {
      "type": "string",
      "minLength": 1
    },
    "endTime": {
      "type": "string",
      "minLength": 1
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "lockTtl": {
      "type": "string"
    },
    "drainTimeout": {
      "type": "string"
    },
    "drainGracePeriod": {
      "type": "integer"
    },
    "blockingPodSelectors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notifyUrl": {
      "type": "string"
    },
    "logFormat": {
      "type": "string",
      "enum": [
        "text",
        "json"
      ]
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
