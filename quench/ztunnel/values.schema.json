{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks ztunnel values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "logLevel": {
      "type": "string",
      "minLength": 1
    },
    "caAddress": {
      "type": "string",
      "minLength": 1
    },
    "xdsAddress": {
      "type": "string",
      "minLength": 1
    },
    "clusterId": {
      "type": "string",
      "minLength": 1
    },
    "extraEnvVars": {
      "type": "array"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    }
  }
}
