{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks falco values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "privileged": { "type": "boolean" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z_]+$" }
    },
    "runtimeSocketDirs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^/" }
    },
    "customRules": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9._-]+\\.ya?ml$" },
      "additionalProperties": { "type": "string" }
    },
    "config": {
      "type": "object",
      "required": ["engine", "webserver"],
      "properties": {
        "engine": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "enum": ["modern_ebpf", "nodriver", "replay"] }
          }
        },
        "webserver": {
          "type": "object",
          "required": ["enabled", "listen_port", "k8s_healthz_endpoint"],
          "properties": {
            "enabled": { "const": true },
            "listen_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "k8s_healthz_endpoint": { "type": "string", "pattern": "^/" }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "tolerations": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "nameOverride": { "type": "string" },
    "imagePullSecrets": { "type": "array" }
  }
}
