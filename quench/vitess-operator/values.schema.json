{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks vitess-operator values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object"
    },
    "podDisruptionBudget": {
      "type": "object"
    },
    "defaultEtcdImage": {
      "type": "string"
    },
    "watchAllNamespaces": {
      "type": "boolean"
    },
    "logVerbosity": {
      "type": "integer",
      "minimum": 0
    },
    "priorityClasses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    }
  }
}
