{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks pinniped values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "replicas": {
      "type": "integer",
      "minimum": 1
    },
    "impersonationProxy": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "enabled",
            "disabled"
          ]
        },
        "externalEndpoint": {
          "type": "string"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "LoadBalancer",
                "ClusterIP",
                "None"
              ]
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "apiServingCertificate": {
      "type": "object",
      "properties": {
        "durationSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "renewBeforeSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "discoveryURL": {
      "type": "string"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "",
        "info",
        "debug",
        "trace",
        "all"
      ]
    },
    "priorityClassNameForKubeCertAgent": {
      "type": "string"
    }
  }
}
