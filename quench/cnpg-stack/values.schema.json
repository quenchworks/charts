{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks cnpg-stack values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "fullnameOverride": {
      "type": "string"
    },
    "partOf": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "selectorLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "cloudnative-pg": {
      "type": "object"
    },
    "cluster": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "extraSpec": {
          "type": "object"
        }
      }
    },
    "pooler": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "poolMode": {
          "type": "string",
          "enum": [
            "session",
            "transaction"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "wiring": {
      "type": "object"
    }
  }
}
