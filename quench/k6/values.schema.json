{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks k6 values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:([a-f0-9]{64}|REPLACE_WITH_IMAGE_DIGEST)$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "job",
        "cronjob"
      ]
    },
    "script": {
      "type": "string"
    },
    "existingConfigMap": {
      "type": "string"
    },
    "scriptFileName": {
      "type": "string"
    },
    "args": {
      "type": "array"
    },
    "extraArgs": {
      "type": "array"
    },
    "vus": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "duration": {
      "type": "string"
    },
    "job": {
      "type": "object",
      "additionalProperties": true
    },
    "cronjob": {
      "type": "object",
      "additionalProperties": true
    },
    "api": {
      "type": "object",
      "additionalProperties": true
    }
  }
}