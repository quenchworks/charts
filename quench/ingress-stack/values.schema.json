{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks ingress-stack values",
  "type": "object",
  "properties": {
    "ingress-nginx": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "cert-manager": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "clusterIssuer": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "rootCommonName": {"type": "string", "minLength": 1},
        "rootDuration": {"type": "string", "pattern": "^[0-9]+h$"},
        "image": {"type": "object", "required": ["repository", "digest"], "properties": {"repository": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
      }
    },
    "imagePullSecrets": {"type": "array"}
  }
}
