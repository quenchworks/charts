{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks crossplane values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string" },
        "leaderElection": { "type": "boolean" },
        "webhooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "healthProbePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "syncInterval": { "type": "string" },
        "pollInterval": { "type": "string" },
        "maxConcurrentReconciles": { "type": ["string", "integer"] },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providers": { "type": "array", "items": { "type": "string" } },
            "functions": { "type": "array", "items": { "type": "string" } },
            "configurations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "packageCache": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "sizeLimit": { "type": "string" } }
        },
        "functionCache": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "sizeLimit": { "type": "string" } }
        }
      }
    },
    "rbacManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "leaderElection": { "type": "boolean" },
        "aggregatedClusterRoles": { "type": "boolean" },
        "restrictProviderPermissions": { "type": "boolean" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "requests": { "type": "object" }, "limits": { "type": "object" } }
        },
        "extraArgs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "requests": { "type": "object" }, "limits": { "type": "object" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowExternal": { "type": "boolean" }
      }
    }
  }
}
