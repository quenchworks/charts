{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks llm-stack values",
  "type": "object",
  "properties": {
    "ollama": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "fullnameOverride": {"const": "llm-ollama"}}},
    "litellm": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "fullnameOverride": {"const": "llm-litellm"}}},
    "qdrant": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "fullnameOverride": {"const": "llm-qdrant"}}},
    "models": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "modelPull": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "image": {"type": "object", "required": ["repository", "digest"], "properties": {"repository": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
      }
    }
  }
}
