{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks hydra values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "command": {
      "type": "array"
    },
    "args": {
      "type": "array"
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "publicPort": {
          "type": "integer"
        },
        "adminPort": {
          "type": "integer"
        },
        "exposeAdmin": {
          "type": "boolean"
        }
      }
    },
    "urls": {
      "type": "object",
      "additionalProperties": true
    },
    "secretsSystem": {
      "type": "string"
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": true
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": true
    },
    "migrate": {
      "type": "object",
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": true
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true
    },
    "rbac": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
