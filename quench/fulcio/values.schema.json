{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks Sigstore Fulcio values",
  "type": "object",
  "properties": {
    "image": {"type": "object", "required": ["repository", "digest"]},
    "replicaCount": {"type": "integer", "minimum": 1},
    "ca": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["ephemeralca", "fileca", "kmsca", "tinkca", "googleca"]},
        "file": {"type": "object"}
      }
    },
    "ctLogUrl": {"type": "string"},
    "config": {"type": "object"},
    "extraArgs": {"type": "array", "items": {"type": "string"}}
  }
}
