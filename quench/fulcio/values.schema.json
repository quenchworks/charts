{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks Sigstore Fulcio values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "ca": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ephemeralca",
            "fileca",
            "kmsca",
            "tinkca",
            "googleca"
          ]
        },
        "file": {
          "type": "object"
        }
      }
    },
    "ctLogUrl": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Issuer",
                    "ClusterIssuer"
                  ]
                }
              }
            },
            "dnsNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "duration": {
              "type": "string"
            }
          }
        },
        "selfSigned": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "validityDays": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
