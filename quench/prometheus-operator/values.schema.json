{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks prometheus-operator values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "configReloader": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "watchNamespaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kubeletService": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
        }
      }
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "all",
        "debug",
        "info",
        "warn",
        "error",
        "none"
      ]
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object"
    },
    "podDisruptionBudget": {
      "type": "object"
    }
  }
}
