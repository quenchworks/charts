{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks DataHub values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gms",
        "frontend",
        "upgrade",
        "kubectl"
      ],
      "properties": {
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "gms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "Pinned by digest, never a tag."
            }
          }
        },
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "Pinned by digest, never a tag."
            }
          }
        },
        "upgrade": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "Pinned by digest, never a tag."
            }
          }
        },
        "kubectl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "Pinned by digest, never a tag."
            }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adminPassword": {
          "type": "string"
        },
        "systemClientSecret": {
          "type": "string"
        },
        "tokenSigningKey": {
          "type": "string"
        },
        "tokenSalt": {
          "type": "string"
        },
        "frontendSecret": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 0
            },
            {
              "type": "string",
              "minLength": 32
            }
          ],
          "description": "Play session secret; at least 32 characters when set."
        }
      }
    },
    "gms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "javaOpts": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "extraEnvVars": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "telemetry": {
          "type": "boolean"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "javaOpts": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "extraEnvVars": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "podDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "javaOpts": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "extraEnvVars": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "topics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partitions": {
          "type": "integer",
          "minimum": 1
        },
        "replicationFactor": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicasPerIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "gmsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "mysql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretPasswordKey": {
          "type": "string"
        }
      }
    },
    "kafka": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "externalKafka": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bootstrapServers": {
          "type": "string"
        }
      }
    },
    "elasticsearch": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "externalElasticsearch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "useSSL": {
          "type": "boolean"
        }
      }
    },
    "podLabels": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "schedulerName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowExternal": {
          "type": "boolean"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "servicePort": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    }
  }
}
