{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks Temporal values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "numHistoryShards": { "type": "integer", "minimum": 1 },
    "postgresql": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "database": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "databases": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "main": { "type": "string", "minLength": 1 },
        "visibility": { "type": "string", "minLength": 1 }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": ["integer", "string"] },
        "user": { "type": "string" },
        "password": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretPasswordKey": { "type": "string" }
      }
    },
    "schemaSetup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "retries": { "type": "integer", "minimum": 1 },
        "retryInterval": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "requests": { "type": "object" }, "limits": { "type": "object" } }
        }
      }
    },
    "temporalConfig": { "type": "string", "minLength": 1 },
    "dynamicConfig": { "type": "string" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "requests": { "type": "object" }, "limits": { "type": "object" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowExternal": { "type": "boolean" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    }
  }
}
