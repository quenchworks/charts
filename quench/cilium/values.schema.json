{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks cilium values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterName": {
          "type": "string",
          "minLength": 1
        },
        "clusterId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "ipam": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clusterPoolIPv4CIDR": {
              "type": "string",
              "minLength": 1
            },
            "clusterPoolIPv4MaskSize": {
              "type": "integer",
              "minimum": 16,
              "maximum": 30
            }
          }
        },
        "routingMode": {
          "type": "string",
          "enum": [
            "tunnel",
            "native"
          ]
        },
        "tunnelProtocol": {
          "type": "string",
          "enum": [
            "vxlan",
            "geneve"
          ]
        },
        "kubeProxyReplacement": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        },
        "policyEnforcementMode": {
          "type": "string",
          "enum": [
            "default",
            "always",
            "never"
          ]
        },
        "debug": {
          "type": "boolean"
        },
        "extraConfig": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "integer",
              "number"
            ]
          }
        }
      }
    },
    "cilium-operator": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraEnvVars": {
      "type": "array"
    },
    "healthPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "priorityClassName": {
      "type": "string"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "updateStrategy": {
      "type": "object"
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    }
  }
}
