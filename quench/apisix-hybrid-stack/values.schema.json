{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks apisix-hybrid-stack values",
  "type": "object",
  "properties": {
    "etcdTLS": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "validityDays": { "type": "integer", "minimum": 1 }
      }
    },
    "etcd": {
      "type": "object",
      "properties": {
        "fullnameOverride": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "const": true },
            "existingSecret": { "type": "string", "minLength": 1 },
            "clientAuth": { "type": "boolean" }
          }
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "properties": { "role": { "const": "control_plane" } }
    },
    "dataPlane": {
      "type": "object",
      "properties": { "role": { "const": "data_plane" } }
    },
    "apisix-ingress-controller": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
