{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks flink-kubernetes-operator values (upstream's chart; the rest of its values pass through)",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "type": "string" }
      },
      "required": ["repository"]
    },
    "webhook": { "type": "object", "properties": { "create": { "type": "boolean" } } }
  }
}
