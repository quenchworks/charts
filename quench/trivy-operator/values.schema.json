{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks trivy-operator values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "targetNamespaces": {
      "type": "string"
    },
    "excludeNamespaces": {
      "type": "string"
    },
    "targetWorkloads": {
      "type": "string"
    },
    "scanners": {
      "type": "object",
      "properties": {
        "vulnerability": {
          "type": "boolean"
        },
        "configAudit": {
          "type": "boolean"
        },
        "rbacAssessment": {
          "type": "boolean"
        },
        "exposedSecret": {
          "type": "boolean"
        },
        "sbom": {
          "type": "boolean"
        },
        "infraAssessment": {
          "type": "boolean"
        },
        "clusterCompliance": {
          "type": "boolean"
        }
      }
    },
    "scanJob": {
      "type": "object",
      "properties": {
        "concurrentLimit": {
          "type": "integer",
          "minimum": 1
        },
        "timeout": {
          "type": "string"
        },
        "retryAfter": {
          "type": "string"
        }
      }
    },
    "trivy": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string"
        },
        "dbRepository": {
          "type": "string"
        },
        "javaDbRepository": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "operatorConfig": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    }
  }
}
