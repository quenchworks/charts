{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "QuenchWorks Strimzi operator values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "kafkaImage": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "upstreamImages": {
      "type": "object",
      "properties": {
        "kafkaBridge": {"type": "string", "minLength": 1},
        "kanikoExecutor": {"type": "string", "minLength": 1},
        "buildah": {"type": "string", "minLength": 1},
        "mavenBuilder": {"type": "string", "minLength": 1}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1},
    "watchAnyNamespace": {"type": "boolean"},
    "logLevel": {"type": "string", "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR"]},
    "fullReconciliationIntervalMs": {"type": "integer", "minimum": 1},
    "operationTimeoutMs": {"type": "integer", "minimum": 1},
    "featureGates": {"type": "string"},
    "extraEnvVars": {"type": "array"},
    "imagePullSecrets": {"type": "array"},
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    }
  }
}
