{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks dev-platform-stack values",
  "type": "object",
  "properties": {
    "urls": { "type": "object", "properties": { "forgejo": { "type": "string", "pattern": "^http://" }, "woodpecker": { "type": "string", "pattern": "^https?://" } }, "required": ["forgejo", "woodpecker"] },
    "admin": { "type": "object", "properties": { "username": { "type": "string", "minLength": 1 }, "email": { "type": "string", "minLength": 3 } } },
    "forgejo": { "type": "object" },
    "woodpecker": { "type": "object" },
    "postgresql": { "type": "object" },
    "valkey": { "type": "object" },
    "oauthJob": { "type": "object" }
  }
}
