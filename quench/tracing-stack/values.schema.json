{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks tracing-stack values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "tempo": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "grafana": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "dashboards": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "otelCollector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "config": { "type": "string", "minLength": 1 },
        "ports": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "otlpGrpc": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "otlpHttp": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "metrics": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "health": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    }
  }
}
