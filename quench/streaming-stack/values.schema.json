{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks streaming-stack values",
  "type": "object",
  "properties": {
    "kafka": {
      "type": "object",
      "properties": {
        "fullnameOverride": { "const": "streaming-kafka" }
      },
      "required": ["fullnameOverride"]
    },
    "karapace": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "fullnameOverride": { "const": "streaming-karapace" }
      }
    },
    "akhq": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "fullnameOverride": { "const": "streaming-akhq" }
      }
    }
  }
}
