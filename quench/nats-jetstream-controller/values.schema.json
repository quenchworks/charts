{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks nats-jetstream-controller values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "natsUrl": {
      "type": "string"
    },
    "crdConnect": {
      "type": "boolean"
    },
    "watchNamespace": {
      "type": "string"
    },
    "readOnly": {
      "type": "boolean"
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "controlLoop": {
      "type": "boolean"
    }
  }
}
