{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks hoppscotch values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowExternal": {
          "type": "boolean"
        },
        "extraLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ingressPorts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "denyAllEgress": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "extraLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "type": "string",
          "enum": [
            "IfHealthyBudget",
            "AlwaysAllow"
          ]
        },
        "extraSelectorLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "postgresql": {
      "type": "object"
    },
    "secret": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "domain": {
      "type": "string"
    },
    "publicScheme": {
      "type": "string",
      "enum": [
        "http",
        "https"
      ]
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": [
            "integer",
            "string"
          ]
        },
        "username": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "sslmode": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "grpcAnnotations": {
          "type": "object"
        },
        "tls": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "adminDomain": {
      "type": "string"
    },
    "backend": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64}|REPLACE_AFTER_CI)$"
            }
          },
          "required": [
            "repository",
            "digest"
          ],
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "trustProxy": {
          "type": "boolean"
        },
        "extraOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64}|REPLACE_AFTER_CI)$"
            }
          },
          "required": [
            "repository",
            "digest"
          ],
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "admin": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64}|REPLACE_AFTER_CI)$"
            }
          },
          "required": [
            "repository",
            "digest"
          ],
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "viteEnv": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": []
}
