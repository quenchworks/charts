{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks secrets-stack values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "realm": {
      "type": "object",
      "properties": {
        "redirectUris": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https?://" } },
        "users": {
          "type": "array",
          "items": { "type": "object", "required": ["username", "password"],
                     "properties": { "username": { "type": "string", "minLength": 1 }, "password": { "type": "string", "minLength": 8 } } }
        }
      }
    },
    "keycloak": {
      "type": "object",
      "properties": {
        "fullnameOverride": { "const": "secrets-keycloak", "description": "OpenBao's wait and the realm mount address Keycloak by this fixed name." },
        "production": { "type": "object", "properties": { "hostname": { "type": "string", "pattern": "^https?://[^/]+$" } } }
      }
    }
  }
}
