{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks backup-stack values",
  "type": "object",
  "properties": {
    "seaweedfs": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fullnameOverride": {
          "const": "backup-seaweedfs"
        }
      }
    },
    "bucketJob": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "velero": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fullnameOverride": {
          "const": "backup-velero"
        }
      }
    }
  }
}
