{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks uptime-kuma values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object"
        },
        "existingClaim": {
          "type": "string"
        },
        "letsencrypt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "httpsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "adminPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "exposeAdmin": {
          "type": "boolean"
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "clusterScoped": {
          "type": "boolean"
        },
        "clusterRules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowExternal": {
          "type": "boolean"
        },
        "extraLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ingressPorts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "denyAllEgress": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "extraLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "type": "string",
          "enum": [
            "IfHealthyBudget",
            "AlwaysAllow"
          ]
        },
        "extraSelectorLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "fullnameOverride": {
      "type": "string"
    },
    "partOf": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "selectorLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Issuer",
                    "ClusterIssuer"
                  ]
                }
              }
            },
            "dnsNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "duration": {
              "type": "string"
            }
          }
        },
        "selfSigned": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "validityDays": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "password": {
          "type": "string",
          "anyOf": [
            {
              "maxLength": 0
            },
            {
              "minLength": 8
            }
          ]
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "streamPorts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "port"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,13}[a-z0-9])?$"
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535,
            "not": {
              "enum": [
                8080,
                8443,
                8181
              ]
            }
          },
          "servicePort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "type": "string",
            "enum": [
              "TCP",
              "UDP"
            ]
          }
        }
      }
    },
    "ipRangesFetch": {
      "type": "boolean"
    },
    "disableIPv6": {
      "type": "boolean"
    }
  }
}
