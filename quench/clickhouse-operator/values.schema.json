{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks clickhouse-operator values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "watchNamespaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object"
    },
    "podDisruptionBudget": {
      "type": "object"
    },
    "metricsExporter": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "digest"
          ]
        },
        "resources": {
          "type": "object"
        }
      }
    }
  }
}
