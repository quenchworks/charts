{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks flux values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "controllers": {
      "type": "object",
      "required": [
        "source",
        "kustomize",
        "helm",
        "notification"
      ],
      "properties": {
        "source": {
          "type": "object",
          "required": [
            "enabled",
            "image"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "required": [
                "repository",
                "digest"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "extraArgs": {
              "type": "array"
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "kustomize": {
          "type": "object",
          "required": [
            "enabled",
            "image"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "required": [
                "repository",
                "digest"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "extraArgs": {
              "type": "array"
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "helm": {
          "type": "object",
          "required": [
            "enabled",
            "image"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "required": [
                "repository",
                "digest"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "extraArgs": {
              "type": "array"
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "notification": {
          "type": "object",
          "required": [
            "enabled",
            "image"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "required": [
                "repository",
                "digest"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "extraArgs": {
              "type": "array"
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    },
    "watchAllNamespaces": {
      "type": "boolean"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "error"
      ]
    },
    "clusterReconciler": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "webhookReceiver": {
      "type": "object",
      "properties": {
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        }
      }
    }
  }
}
