{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks istio-cni values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "logLevel": {
      "type": "string",
      "minLength": 1
    },
    "ambient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dnsCapture": {
          "type": "boolean"
        },
        "ipv6": {
          "type": "boolean"
        }
      }
    },
    "excludeNamespaces": {
      "type": "string"
    },
    "cniBinDir": {
      "type": "string",
      "pattern": "^/"
    },
    "cniConfDir": {
      "type": "string",
      "pattern": "^/"
    },
    "extraConfig": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "integer"
        ]
      }
    }
  }
}
