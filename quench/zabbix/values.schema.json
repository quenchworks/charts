{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks zabbix values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "password": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "serverName": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    }
  }
}
