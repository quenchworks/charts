{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks descheduler values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "deschedulingInterval": {
      "type": "string",
      "minLength": 1
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resourceName": {
          "type": "string",
          "minLength": 1
        },
        "resourceNamespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "string"
        },
        "existingConfigMap": {
          "type": "string"
        }
      }
    },
    "verbosity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metricsPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "clusterScoped": {
          "type": "boolean"
        },
        "clusterRules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowExternal": {
          "type": "boolean"
        },
        "extraLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ingressPorts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "denyAllEgress": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "extraLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "type": "string",
          "enum": [
            "IfHealthyBudget",
            "AlwaysAllow"
          ]
        },
        "extraSelectorLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "fullnameOverride": {
      "type": "string"
    },
    "partOf": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "selectorLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array"
    }
  }
}
