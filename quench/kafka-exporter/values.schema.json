{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks kafka-exporter values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "kafkaServers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[^:]+:[0-9]+$"
      }
    },
    "sasl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mechanism": {
          "type": "string",
          "enum": [
            "plain",
            "scram-sha256",
            "scram-sha512"
          ]
        },
        "username": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretPasswordKey": {
          "type": "string"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "insecureSkipVerify": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "topicFilter": {
      "type": "string"
    },
    "groupFilter": {
      "type": "string"
    },
    "verbosity": {
      "type": "integer",
      "minimum": 0
    },
    "kafkaVersion": {
      "type": "string"
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
