{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks Sigstore Timestamp Authority values",
  "type": "object",
  "properties": {
    "image": {"type": "object", "required": ["repository", "digest"]},
    "replicaCount": {"type": "integer", "minimum": 1},
    "signer": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["memory", "file", "kms", "tink"]},
        "file": {"type": "object"}
      }
    },
    "ntpMonitoring": {"type": "boolean"},
    "extraArgs": {"type": "array", "items": {"type": "string"}}
  }
}
