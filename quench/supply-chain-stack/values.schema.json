{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks supply-chain-stack values",
  "type": "object",
  "properties": {
    "kyverno": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "trivy-operator": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "verifyImages": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "namespaceLabel": {"type": "string", "minLength": 1},
        "allowedImages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "subjectRegExp": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "rekorUrl": {"type": "string"},
        "webhookTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "image": {"type": "object", "required": ["repository", "digest"], "properties": {"repository": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
      }
    },
    "imagePullSecrets": {"type": "array"}
  }
}
