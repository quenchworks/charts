{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks identity-stack values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "shared": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dbPassword": { "type": "string" },
        "oidcRealm": { "type": "string", "minLength": 1 },
        "oidcClientID": { "type": "string" },
        "oidcClientSecret": { "type": "string" },
        "cookieSecret": { "type": "string" }
      }
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "oauth2Proxy": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
