{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks Graylog values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Image is pinned by digest, never a tag."
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "graylog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalUri"],
      "properties": {
        "externalUri": { "type": "string", "minLength": 1 },
        "bindAddress": { "type": "string", "minLength": 1 },
        "adminUsername": { "type": "string", "minLength": 1 },
        "adminPassword": { "type": "string" },
        "passwordSecret": { "type": "string" },
        "mongodbDatabase": { "type": "string", "minLength": 1 },
        "serverJavaOpts": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "requests": { "type": "object" }, "limits": { "type": "object" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "port"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "protocol": { "type": "string", "enum": ["TCP", "UDP"] }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "object" },
        "existingClaim": { "type": "string" }
      }
    },
    "mongodb": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "rootUsername": { "type": "string", "minLength": 1 },
            "rootPassword": { "type": "string" }
          }
        }
      }
    },
    "opensearch": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "externalMongodb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretUriKey": { "type": "string" }
      }
    },
    "externalOpensearch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": { "type": "string" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowExternal": { "type": "boolean" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    }
  }
}
