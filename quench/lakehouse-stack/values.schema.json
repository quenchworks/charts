{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks lakehouse-stack values",
  "type": "object",
  "properties": {
    "trino": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "fullnameOverride": {"const": "lake-trino"}}},
    "nessie": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "fullnameOverride": {"const": "lake-nessie"}}},
    "seaweedfs": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "fullnameOverride": {"const": "lake-seaweedfs"}}},
    "bucketJob": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "image": {"type": "object", "required": ["repository", "digest"], "properties": {"repository": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
      }
    }
  }
}
