{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks workflow-stack values",
  "type": "object",
  "properties": {
    "temporal": { "type": "object" },
    "temporal-ui": { "type": "object" },
    "namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 }, "retention": { "type": "string" } },
        "required": ["name"]
      }
    },
    "cli": { "type": "object" }
  }
}
