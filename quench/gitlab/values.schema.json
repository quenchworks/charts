{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quenchworks gitlab values",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "gitlab"
  ],
  "properties": {
    "gitlab": {
      "type": "object",
      "required": [
        "host"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Hostname GitLab is served at (no scheme)."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "https": {
          "type": "boolean"
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monitoringAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "CIDRs allowed to call /-/readiness and /-/liveness (the probes)."
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "rails": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "repository",
            "digest"
          ]
        }
      }
    },
    "workhorse": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "repository",
            "digest"
          ]
        },
        "port": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "webservice": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "livenessInitialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "puma": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer"
            },
            "workers": {
              "type": "integer",
              "minimum": 0
            },
            "minThreads": {
              "type": "integer",
              "minimum": 1
            },
            "maxThreads": {
              "type": "integer",
              "minimum": 1
            },
            "workerTimeout": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "sidekiq": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "gitaly": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "repository",
            "digest"
          ]
        },
        "port": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "gitlabShell": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "repository",
            "digest"
          ]
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer"
            }
          }
        }
      }
    },
    "extraEnvVars": {
      "type": "array"
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "database": {
              "type": "string"
            },
            "username": {
              "type": "string"
            }
          }
        }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
