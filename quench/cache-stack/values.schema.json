{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks cache-stack values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "metrics": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean", "description": "The stack exists to scrape this; turning it off leaves Prometheus with nothing to discover." } }
        }
      }
    },
    "prometheus": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "grafana": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "dashboards": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
  }
}
