{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks falcosidekick values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64}|REPLACE_AFTER_CI)$"
        }
      },
      "required": [
        "repository",
        "digest"
      ],
      "additionalProperties": false
    },
    "interface": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "update": {
          "type": "boolean"
        },
        "localRules": {
          "type": "string"
        }
      }
    },
    "logHostPath": {
      "type": "string",
      "pattern": "^(|/.*)$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "NET_RAW",
          "NET_ADMIN",
          "SYS_NICE",
          "IPC_LOCK",
          "SETUID",
          "SETGID",
          "SETPCAP"
        ]
      }
    }
  },
  "required": []
}
