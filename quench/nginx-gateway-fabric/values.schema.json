{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks nginx-gateway-fabric values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "description": "The control plane. Also injected as the init container of every data-plane pod.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "registry": { "type": "string" },
        "pullSecrets": { "type": "array" }
      }
    },
    "nginx": {
      "description": "The data plane. NGF provisions this workload itself from the NginxProxy resource; nothing here becomes a pod spec in this chart.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "digest": {
              "description": "Empty falls back to the upstream F5 image compiled into the control plane.",
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
            "registry": { "type": "string" }
          }
        },
        "kind": { "type": "string", "enum": ["deployment", "daemonSet"] },
        "replicas": { "type": "integer", "minimum": 1 },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] }
          }
        },
        "config": {
          "description": "Extra NginxProxy spec. telemetry.exporter is refused: the QuenchWorks data-plane image does not build ngx_otel_module, and NGF would emit a load_module line for it that makes the next nginx reload fail.",
          "type": "object",
          "properties": {
            "telemetry": {
              "type": "object",
              "not": { "required": ["exporter"] }
            }
          }
        }
      }
    },
    "controllerName": { "type": "string", "minLength": 1, "pattern": "^[^/]+/[^/]+$" },
    "gatewayClass": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" }
      }
    },
    "watchNamespaces": { "type": "array", "items": { "type": "string" } },
    "logLevel": { "type": "string", "enum": ["debug", "info", "error"] },
    "clusterDomain": { "type": "string", "minLength": 1 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "secure": { "type": "boolean" }
      }
    },
    "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "productTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "snippetsFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "snippets": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "gatewayApiExperimentalFeatures": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "certGenerator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "serverTLSSecretName": { "type": "string", "minLength": 1 },
        "agentTLSSecretName": { "type": "string", "minLength": 1 },
        "overwrite": { "type": "boolean" },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": { "type": "object" },
            "limits": { "type": "object" }
          }
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "annotations": { "type": "object" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "podLabels": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "affinity": { "type": "object" },
    "tolerations": { "type": "array" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "schedulerName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "updateStrategy": { "type": "object" },
    "extraEnvVars": { "type": "array" },
    "extraEnvVarsCM": { "type": "string" },
    "extraEnvVarsSecret": { "type": "string" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "initContainers": { "type": "array" },
    "sidecars": { "type": "array" },
    "lifecycleHooks": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "customLivenessProbe": { "type": "object" },
    "customReadinessProbe": { "type": "object" },
    "customStartupProbe": { "type": "object" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowExternal": { "type": "boolean" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    }
  }
}
