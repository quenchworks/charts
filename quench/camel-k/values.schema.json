{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "QuenchWorks Camel K operator values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "watchAnyNamespace": {"type": "boolean"},
    "operatorId": {"type": "string", "minLength": 1},
    "logLevel": {"type": "string", "enum": ["debug", "info", "error"]},
    "registry": {
      "type": "object",
      "properties": {
        "address": {"type": "string"},
        "insecure": {"type": "boolean"},
        "secret": {"type": "string"},
        "organization": {"type": "string"}
      }
    },
    "extraEnvVars": {"type": "array"},
    "imagePullSecrets": {"type": "array"},
    "resources": {"type": "object"},
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    }
  }
}
