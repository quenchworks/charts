{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks dragonfly-operator values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "dragonflyImage": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "tag",
        "digest"
      ]
    },
    "watchCurrentNamespace": {
      "type": "boolean"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    }
  }
}
