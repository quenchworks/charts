{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks argocd values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nameOverride": { "type": "string" },
    "logFormat": { "type": "string", "enum": ["json", "text"] },
    "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "type": "boolean" },
        "keep": { "type": "boolean" },
        "annotations": { "type": "object" }
      }
    },
    "configs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "cm": { "type": "object" },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policyDefault": { "type": "string" },
            "policyCsv": { "type": "string" },
            "scopes": { "type": "string" }
          }
        },
        "sshKnownHosts": { "type": "string" },
        "tlsCerts": { "type": "object", "additionalProperties": { "type": "string" } },
        "gpgKeys": { "type": "object", "additionalProperties": { "type": "string" } },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "argocdServerAdminPassword": { "type": "string" },
            "extra": { "type": "object" }
          }
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "insecure": { "type": "boolean" },
        "rootpath": { "type": "string" },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "nodePort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
            "annotations": { "type": "object" }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "repoServer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "disableTLS": { "type": "boolean" },
        "parallelismLimit": { "type": "integer", "minimum": 0 },
        "helmWorkingDirSizeLimit": { "type": "string" },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
        },
        "resources": { "type": "object" }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "statusProcessors": { "type": ["string", "integer"] },
        "operationProcessors": { "type": ["string", "integer"] },
        "shardingAlgorithm": { "type": "string", "enum": ["", "legacy", "round-robin", "consistent-hashing"] },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "object" }
      }
    },
    "applicationSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "webhookPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "probePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "enableLeaderElection": { "type": "boolean" },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "object" }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "cm": { "type": "object" },
        "secret": { "type": "object" },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "object" }
      }
    },
    "externalRedis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "db": { "type": "integer", "minimum": 0 },
        "password": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretPasswordKey": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "clusterScoped": { "type": "boolean" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "server": { "type": "string" },
        "repoServer": { "type": "string" },
        "controller": { "type": "string" },
        "applicationSet": { "type": "string" },
        "notifications": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowExternal": { "type": "boolean" }
      }
    }
  }
}
