{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "localDomain"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "streaming": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "localDomain": {
      "type": "string",
      "minLength": 1
    },
    "webDomain": {
      "type": "string"
    },
    "registrationsMode": {
      "type": "string",
      "enum": [
        "open",
        "approved",
        "none"
      ]
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sidekiq": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "extraArgs": {
          "type": "array"
        }
      }
    },
    "extraEnvVars": {
      "type": "array"
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "externalRedis": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "accessModes": {
          "type": "array"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "streamingPort": {
          "type": "integer"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "array"
        }
      }
    }
  }
}
