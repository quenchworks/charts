{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks linkerd-cni values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inboundPort": {
          "type": "integer"
        },
        "outboundPort": {
          "type": "integer"
        },
        "uid": {
          "type": "integer"
        },
        "ignoreInboundPorts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignoreOutboundPorts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "iptablesMode": {
      "type": "string",
      "enum": [
        "nft",
        "legacy"
      ]
    },
    "disableIPv6": {
      "type": "boolean"
    },
    "logLevel": {
      "type": "string"
    },
    "cniBinDir": {
      "type": "string",
      "pattern": "^/"
    },
    "cniConfDir": {
      "type": "string",
      "pattern": "^/"
    },
    "priorityClassName": {
      "type": "string"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    }
  }
}
