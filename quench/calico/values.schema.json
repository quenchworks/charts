{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks calico values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "operatorVersion": {
      "type": "string"
    },
    "calicoImages": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "installation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "podCIDR": {
          "type": "string"
        },
        "encapsulation": {
          "type": "string",
          "enum": [
            "IPIP",
            "IPIPCrossSubnet",
            "VXLAN",
            "VXLANCrossSubnet",
            "None"
          ]
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "wiring": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
