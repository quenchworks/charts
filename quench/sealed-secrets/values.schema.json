{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks sealed-secrets values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keyPrefix": { "type": "string", "minLength": 1 },
        "keySize": { "type": "integer", "minimum": 2048 },
        "keyRenewPeriod": { "type": "string" },
        "allNamespaces": { "type": "boolean" },
        "additionalNamespaces": { "type": "string" },
        "labelSelector": { "type": "string" },
        "updateStatus": { "type": "boolean" },
        "logLevel": { "type": "string", "enum": ["INFO", "ERROR"] },
        "logFormat": { "type": "string", "enum": ["text", "json"] },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "extraArgs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "requests": { "type": "object" }, "limits": { "type": "object" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "serviceProxier": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowExternal": { "type": "boolean" }
      }
    }
  }
}
