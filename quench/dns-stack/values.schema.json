{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks dns-stack values",
  "type": "object",
  "properties": {
    "zones": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9.-]+[A-Za-z0-9]$"
      }
    },
    "powerdns": {
      "type": "object"
    },
    "external-dns": {
      "type": "object"
    },
    "zoneJob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "global": {
      "type": "object"
    }
  }
}
