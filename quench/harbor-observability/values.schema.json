{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks Harbor observability values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "harbor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "namespace": { "type": "string" },
        "metricsService": { "type": "string" },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metricsPath": { "type": "string" },
        "scrapeInterval": { "type": "string" },
        "components": { "type": "array" }
      }
    },
    "dashboards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "configMapName": { "type": "string", "minLength": 1 }
      }
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "grafana": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
