{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks phpMyAdmin values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Image is pinned by digest, never a tag."
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "phpmyadmin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": { "type": "string" },
        "verboseNames": { "type": "string" },
        "authType": { "type": "string", "enum": ["cookie", "config", "http", "signon"] },
        "absoluteUri": { "type": "string" },
        "allowNoPassword": { "type": "boolean" },
        "blowfishSecret": {
          "type": "string",
          "description": "32-character cookie-signing key. Empty means the chart generates one and keeps it across upgrades."
        },
        "existingSecret": { "type": "string" },
        "existingSecretBlowfishKey": { "type": "string", "minLength": 1 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "requests": { "type": "object" }, "limits": { "type": "object" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "mariadb": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rootPassword": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "database": { "type": "string" }
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": ["integer", "string"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowExternal": { "type": "boolean" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    }
  }
}
