{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks mysql-ha-stack values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "fullnameOverride": {
      "type": "string"
    },
    "partOf": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "selectorLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "mariadb-operator": {
      "type": "object"
    },
    "galera": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "boolean"
        },
        "extraSpec": {
          "type": "object"
        }
      }
    },
    "wiring": {
      "type": "object"
    }
  }
}
