{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks emissary values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "crds": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "singleNamespace": {
      "type": "boolean"
    },
    "ambassadorId": {
      "type": "string"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "httpPort": {
          "type": "integer"
        },
        "httpsPort": {
          "type": "integer"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "clusterScoped": {
          "type": "boolean"
        },
        "rules": {
          "type": "array"
        },
        "clusterRules": {
          "type": "array"
        }
      }
    }
  }
}
