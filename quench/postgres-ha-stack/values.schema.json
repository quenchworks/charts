{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Quenchworks postgres-ha-stack values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "auth": { "type": "object", "properties": { "password": { "type": "string" } } },
    "postgresql": {
      "type": "object",
      "properties": {
        "fullnameOverride": { "const": "postgres-ha", "description": "The other components address the cluster by this fixed name." },
        "architecture": { "const": "replication" },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": { "const": "postgres-ha-auth" },
            "database": { "type": "string", "minLength": 1, "not": { "const": "postgres" } }
          }
        }
      }
    },
    "pgbouncer": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "exporter": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
        }
      }
    },
    "prometheus": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "grafana": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "dashboards": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
  }
}
