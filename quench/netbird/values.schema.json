      "additionalProperties": false
    },
    "domain": {
      "type": "string"
    },
    "publicScheme": {
      "type": "string",
      "enum": [
        "http",
        "https"
      ]
    },
    "management": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64}|REPLACE_AFTER_CI)$"
            }
          },
          "required": [
            "repository",
            "digest"
          ],
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "logLevel": {
          "type": "string"
        },
        "dnsDomain": {
          "type": "string",
          "minLength": 1
