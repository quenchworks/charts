        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
