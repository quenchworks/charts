      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64}|REPLACE_AFTER_CI)$"
            }
          },
          "required": [
            "repository",
            "digest"
          ],
          "additionalProperties": false
